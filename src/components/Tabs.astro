---
/**
 * Tabs component — Overview / Advanced content pattern.
 * 
 * Usage in MDX:
 *   <Tabs>
 *     <Tab label="Overview">Overview content</Tab>
 *     <Tab label="Advanced">Advanced content</Tab>
 *   </Tabs>
 * 
 * Features:
 *   - ARIA tabs pattern (arrow key navigation)
 *   - URL parameter persistence (?tab=overview)
 *   - Content fade-in animation on switch
 *   - Both panels in DOM (hidden attribute, not removed)
 * 
 * CSS classes: .tabs, .tab-list, [role="tab"], .tab-panel
 * Defined in tokens-and-components.css
 */
---

<div class="tabs">
  <div class="tab-list" role="tablist">
    <!-- Tab buttons injected by client script from child Tab labels -->
  </div>
  <div class="tab-panels">
    <slot />
  </div>
</div>

<script>
  // Tabs initialization.
  // NOTE: this must run on the initial page load, not only on `astro:page-load`.
  // `astro:page-load` is fired exclusively by Astro's ClientRouter/ViewTransitions,
  // which this project does not use — so binding to it alone left every tab dead
  // (both panels rendered stacked with no tab bar). We run the initializer directly
  // (component <script> is a deferred module, so the DOM is already parsed) and also
  // keep the `astro:page-load` binding in case ViewTransitions is adopted later.

  // Keep the "On this page" TOC in sync with the active tab. The TOC is a flat,
  // build-time list of every heading (both panels), so without this it double-lists
  // the Overview and Advanced headings. A TOC link whose target heading lives inside
  // a hidden tab panel is hidden too; headings not inside any panel (untabbed pages,
  // or content outside <Tabs>) always stay visible. Inline display is used so it wins
  // over the stylesheet's `.toc-link` rule.
  function syncTocToActiveTab() {
    document.querySelectorAll('.toc-link').forEach((link) => {
      const href = link.getAttribute('href') || '';
      if (!href.startsWith('#')) return;
      const id = decodeURIComponent(href.slice(1));
      const target = document.getElementById(id);
      const panel = target ? target.closest('.tab-panel') : null;
      const hidden = !!panel && panel.hasAttribute('hidden');
      (link as HTMLElement).style.display = hidden ? 'none' : '';
    });
  }

  function initTabs() {
    document.querySelectorAll('.tabs').forEach((tabsEl) => {
      // Guard against double-initialization (direct call + astro:page-load).
      if ((tabsEl as HTMLElement).dataset.tabsInit === 'true') return;
      (tabsEl as HTMLElement).dataset.tabsInit = 'true';

      const tabList = tabsEl.querySelector('.tab-list');
      const panels = tabsEl.querySelectorAll('.tab-panel');
      if (!tabList || panels.length === 0) return;

      // Build tab buttons from panel data-label attributes
      tabList.innerHTML = '';
      panels.forEach((panel, i) => {
        const label = (panel as HTMLElement).dataset.label || `Tab ${i + 1}`;
        const id = label.toLowerCase().replace(/\s+/g, '-');
        const btn = document.createElement('button');
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        btn.setAttribute('aria-controls', `panel-${id}`);
        btn.setAttribute('id', `tab-${id}`);
        btn.textContent = label;
        tabList.appendChild(btn);

        (panel as HTMLElement).setAttribute('role', 'tabpanel');
        (panel as HTMLElement).setAttribute('id', `panel-${id}`);
        (panel as HTMLElement).setAttribute('aria-labelledby', `tab-${id}`);
        if (i !== 0) (panel as HTMLElement).setAttribute('hidden', '');
      });

      // Click handler
      tabList.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[role="tab"]');
        if (!btn) return;

        tabList.querySelectorAll('[role="tab"]').forEach((t) => {
          t.setAttribute('aria-selected', 'false');
        });
        btn.setAttribute('aria-selected', 'true');

        panels.forEach((p) => (p as HTMLElement).setAttribute('hidden', ''));
        const targetId = btn.getAttribute('aria-controls');
        const targetPanel = tabsEl.querySelector(`#${targetId}`);
        if (targetPanel) {
          (targetPanel as HTMLElement).removeAttribute('hidden');
          // Update URL without reload
          const tabName = btn.getAttribute('id')?.replace('tab-', '') || '';
          const url = new URL(window.location.href);
          url.searchParams.set('tab', tabName);
          history.replaceState(null, '', url.toString());
        }
        syncTocToActiveTab();
      });

      // Arrow key navigation
      tabList.addEventListener('keydown', (e) => {
        const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
        const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
        let next = current;

        if ((e as KeyboardEvent).key === 'ArrowRight') next = (current + 1) % tabs.length;
        else if ((e as KeyboardEvent).key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
        else return;

        (e as Event).preventDefault();
        (tabs[next] as HTMLElement).click();
        (tabs[next] as HTMLElement).focus();
      });

      // Restore tab from URL now that handlers are attached (?tab=advanced deep-link).
      // This click also runs syncTocToActiveTab() via the click handler.
      const params = new URLSearchParams(window.location.search);
      const urlTab = params.get('tab');
      const urlTarget = urlTab ? tabList.querySelector(`[id="tab-${urlTab}"]`) : null;
      if (urlTarget) {
        (urlTarget as HTMLElement).click();
      } else {
        // No deep-link: filter the TOC to the default (first) tab.
        syncTocToActiveTab();
      }
    });
  }

  // Run now (deferred module → DOM is parsed) and again after any view transition.
  initTabs();
  document.addEventListener('astro:page-load', initTabs);
</script>
