---
/**
 * SidebarNav — Documentation sidebar navigation.
 * Reads from content collection and renders grouped section links.
 * Sections are collapsible (<details>/<summary>), default closed; the section
 * containing the current page is auto-expanded.
 * CSS classes: .sidebar-section, .sidebar-section-label, .sidebar-link, .sidebar-link.active, .nav-badge
 * Defined in tokens-and-components.css
 */
import { getCollection } from 'astro:content';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const entries = await getCollection('docs');

// Section config: defines display order and labels
const SECTIONS = [
  { key: 'get-started', label: 'Get Started' },
  { key: 'pocketd', label: 'pocketd CLI' },
  { key: 'ansible-automations', label: 'Ansible Automations' },
  { key: 'developers', label: 'Developers' },
  { key: 'node-operators', label: 'Node Operators' },
  { key: 'igniter', label: 'Igniter' },
  { key: 'gateways', label: 'Gateways' },
  { key: 'path', label: 'PATH' },
  { key: 'token', label: 'Token' },
  { key: 'wallets', label: 'Wallets' },
  { key: 'governance', label: 'Governance' },
  { key: 'protocol', label: 'Protocol' },
  { key: 'reference', label: 'Reference' },
  { key: 'ecosystem', label: 'Ecosystem' },
  { key: 'foundation', label: 'Foundation' },
  { key: 'deprecated', label: 'Deprecated' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Path without base (used for active-link comparison against currentPath)
function entryPath(id: string): string {
  if (id === 'index') return '/';
  if (id.endsWith('/index')) return '/' + id.slice(0, -'/index'.length) + '/';
  return '/' + id + '/';
}

// Full href with base prefix (used in <a href>)
function entryHref(id: string): string {
  return base + entryPath(id);
}

// Group entries by top-level section key. Section landing pages (index.md/mdx)
// are loaded with an id equal to the section key itself (no slash), so an entry
// with no slash belongs to the section named by its own id.
const bySection: Record<string, typeof entries> = {};
for (const entry of entries) {
  const slash = entry.id.indexOf('/');
  const section = slash > -1 ? entry.id.slice(0, slash) : entry.id;
  if (!bySection[section]) bySection[section] = [];
  bySection[section].push(entry);
}

// A section landing page has an id with no slash (e.g. "igniter"); its children
// are "igniter/<page>".
function isLanding(id: string): boolean {
  return !id.includes('/');
}

// Sort: section landing (Overview) page first, then alphabetical by title
function sortEntries(list: typeof entries) {
  return [...list].sort((a, b) => {
    const aIdx = isLanding(a.id);
    const bIdx = isLanding(b.id);
    if (aIdx && !bIdx) return -1;
    if (!aIdx && bIdx) return 1;
    return a.data.title.localeCompare(b.data.title);
  });
}

// Normalize path for active comparison (currentPath has no base prefix)
const normalizedCurrent = currentPath.replace(/\/$/, '') || '/';
---

<!-- Home link -->
<a href={entryHref('index')} class={`sidebar-link sidebar-home${normalizedCurrent === '/' ? ' active' : ''}`}>Documentation</a>

<!-- Section groups (collapsible, default closed; current section auto-expands) -->
{SECTIONS.map(({ key, label }) => {
  const pages = bySection[key];
  if (!pages || pages.length === 0) return null;
  const sorted = sortEntries(pages);
  // Open this section if it's the active page — either the section landing
  // page (/{key}) or any of its child links.
  const containsActive =
    normalizedCurrent === '/' + key ||
    sorted.some((entry) => {
      const normPath = entryPath(entry.id).replace(/\/$/, '') || '/';
      return normalizedCurrent === normPath;
    });
  return (
    <details class="sidebar-section" open={containsActive}>
      <summary class="sidebar-section-label">
        <span>{label}</span>
        <svg class="sidebar-section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </summary>
      {sorted.map((entry) => {
        const path = entryPath(entry.id);
        const normPath = path.replace(/\/$/, '') || '/';
        const isActive = normalizedCurrent === normPath;
        return (
          <a href={entryHref(entry.id)} class={`sidebar-link${isActive ? ' active' : ''}`}>
            {isLanding(entry.id) ? 'Overview' : entry.data.title}
            {entry.data.status === 'new' && <span class="nav-badge">New</span>}
          </a>
        );
      })}
    </details>
  );
})}
